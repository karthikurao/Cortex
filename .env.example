# =============================================================================
# Cortex — LLM Provider Configuration
# =============================================================================
# Supported providers: github | nvidia | ollama
#
#  github  — GitHub Models API (requires a free GitHub token, uses GPT-4o etc.)
#  nvidia  — NVIDIA NIM API (requires NVIDIA API key, serves open-source models
#             like DeepSeek-R1 and Llama 3.3 — the strongest available open-source models)
#  ollama  — Local Ollama server (FREE, no API key required, runs open-source
#             models like DeepSeek-R1, Llama 3.3, Qwen 2.5 entirely on your machine)
# =============================================================================
LLM_PROVIDER=github

# -----------------------------------------------------------------------------
# GitHub Models API (LLM_PROVIDER=github)
# Get your free token at: https://github.com/settings/tokens
# -----------------------------------------------------------------------------
GITHUB_TOKEN=your_github_token_here

# -----------------------------------------------------------------------------
# NVIDIA NIM API (LLM_PROVIDER=nvidia)
# Get your free API key at: https://build.nvidia.com
# Recommended models (strongest open-source):
#   deepseek-ai/deepseek-r1          — Best reasoning, open-source, free tier available
#   nvidia/llama-3.1-nemotron-ultra-253b-v1  — NVIDIA's strongest open-source model
#   meta/llama-3.3-70b-instruct      — Fast, high quality, open-source
#   meta/llama-3.1-405b-instruct     — Largest Llama, top-tier quality
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here

# -----------------------------------------------------------------------------
# Ollama (LLM_PROVIDER=ollama)
# Runs 100% locally — FREE, no API key, full privacy.
# Install Ollama: https://ollama.com/download
# Pull the strongest open-source models:
#   ollama pull deepseek-r1          — Best reasoning model (multiple sizes)
#   ollama pull llama3.3             — Meta Llama 3.3 70B
#   ollama pull qwen2.5:72b          — Alibaba Qwen 2.5 72B
#   ollama pull mistral-large        — Mistral Large 2
# OLLAMA_BASE_URL defaults to http://localhost:11434 if not set.
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Model configuration
# -----------------------------------------------------------------------------
# GitHub provider default:
MODEL_NAME=gpt-4o

# NVIDIA provider — set to a strong open-source model, e.g.:
# MODEL_NAME=deepseek-ai/deepseek-r1

# Ollama provider — set to any model you have pulled locally, e.g.:
# MODEL_NAME=deepseek-r1

API_BASE_URL=https://models.inference.ai.azure.com
TOP_P=1.0

# Agent settings
MAX_TOKENS=4096
TEMPERATURE=0.3
VERBOSE=false
